<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="AppThemeDark" />

    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/naigre_dark_background</item>
        <item name="android:navigationBarColor">@color/naigre_dark_background</item>
        <item name="android:statusBarColor">@color/naigre_dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/naigre_dark_text_muted</item>
        <item name="android:colorControlNormal">@color/naigre_dark_text_secondary</item>
        <item name="android:colorControlActivated">@color/naigre_dark_text_primary</item>
        <item name="android:colorControlHighlight">@color/naigre_dark_control_highlight</item>
        <item name="android:colorButtonNormal">@color/naigre_dark_surface_selected</item>
        <item name="android:buttonStyle">@style/NaigreButton</item>
        <item name="android:buttonBarButtonStyle">@style/NaigreButton</item>
        <item name="android:textColorPrimary">@color/naigre_dark_text_primary</item>
        <item name="android:textColorSecondary">@color/naigre_dark_text_secondary</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="AppThemeLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/naigre_light_background</item>
        <item name="android:navigationBarColor">@color/naigre_light_background</item>
        <item name="android:statusBarColor">@color/naigre_light_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/naigre_light_text_muted</item>
        <item name="android:colorControlNormal">@color/naigre_light_text_secondary</item>
        <item name="android:colorControlActivated">@color/naigre_light_text_primary</item>
        <item name="android:colorControlHighlight">@color/naigre_light_control_highlight</item>
        <item name="android:colorButtonNormal">@color/naigre_light_surface_selected</item>
        <item name="android:buttonStyle">@style/NaigreButton</item>
        <item name="android:buttonBarButtonStyle">@style/NaigreButton</item>
        <item name="android:textColorPrimary">@color/naigre_light_text_primary</item>
        <item name="android:textColorSecondary">@color/naigre_light_text_secondary</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="FullScreenDialogThemeDark" parent="AppThemeDark">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="FullScreenDialogThemeLight" parent="AppThemeLight">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="NaigreNoWindowAnimation">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>

    <style name="NaigreButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/naigre_button_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
